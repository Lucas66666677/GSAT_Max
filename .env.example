# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./backend/gsat_english.db
API_CORS_ORIGINS=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080

# Authentication. Generate a long random value for production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI-compatible API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
CODEX_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3

# Free/low-cost provider router. Keys stay on the FastAPI server only.
AI_PROVIDER_ORDER=gemini,groq,openai,ollama
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_REDACT_STUDENT_PII=true

# Optional local Ollama provider used by selected generators
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90

# Native integrations
REVENUECAT_WEBHOOK_AUTH=
MAX_UPLOAD_BYTES=10485760
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Development provider accepts requests without sending network email.
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@gsat-max.local
