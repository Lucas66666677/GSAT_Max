# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./backend/gsat_english.db
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_APP_URL=http://localhost:8080
# Host header allowlist. Leaving this unset keeps the built-in default, which
# already covers the production hostname and local development.
TRUSTED_HOSTS=gsat-max-api-lucas.onrender.com,localhost,127.0.0.1
DEFAULT_USER_EMAIL=demo@student.local

# Authentication. Generate a long random value for production.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# PBKDF2 cost. The floor of 120000 suits the Render free tier's 0.1 CPU; raise
# it once the service moves to paid compute. Existing accounts are re-hashed
# on their next successful login.
PASSWORD_HASH_ITERATIONS=120000

# OpenAI-compatible API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# CODEX_MODEL wins when both are set; OPENAI_MODEL is the fallback name.
CODEX_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3

# Free/low-cost provider router. Keys stay on the FastAPI server only.
AI_PROVIDER_ORDER=gemini,groq,openai,ollama
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_REDACT_STUDENT_PII=true

# Optional local Ollama provider used by selected generators
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=90

# Native integrations
REVENUECAT_WEBHOOK_AUTH=
MAX_UPLOAD_BYTES=10485760
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Development provider accepts requests without sending network email.
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@gsat-max.local
