{
  "buildCommand": "bash scripts/vercel_build_web.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skipping default install; scripts/vercel_build_web.sh runs flutter pub get'",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
